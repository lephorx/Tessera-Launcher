# Postgres connection. Leave empty to use an embedded PGlite database in DATA_DIR (dev only).
DATABASE_URL=
DATA_DIR=.data
PORT=8080
# Public URL of this cloud, sent to agents after pairing and used for the Origin check.
PUBLIC_URL=http://localhost:8080
# Extra origins allowed to use cookie sessions (comma separated), e.g. the web dashboard in dev.
WEB_ORIGINS=http://localhost:3000
LOG_LEVEL=info
