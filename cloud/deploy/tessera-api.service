[Unit]
Description=Tessera API (behind Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
User=tessera
Group=tessera
WorkingDirectory=/opt/tessera-api
EnvironmentFile=/etc/tessera/api.env
ExecStart=/usr/bin/node /opt/tessera-api/server.mjs
Restart=always
RestartSec=3
# nothing to write, nothing to see outside its own directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
